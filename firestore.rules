rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }

    function isAdminUser() {
      return isSignedIn() && request.auth.token.email == 'mrityunjoyk29@gmail.com';
    }

    function isValidNestedScore(nested) {
      return nested is map 
        && (!nested.keys().hasAny(['score']) || nested.score is number || nested.score == null)
        && (!nested.keys().hasAny(['percentile']) || nested.percentile is number || nested.percentile == null)
        && (!nested.keys().hasAny(['accuracy']) || nested.accuracy is number || nested.accuracy == null);
    }

    function isValidMockScore(data) {
      return data.keys().hasAll(['id', 'userId', 'examType', 'mockName', 'date', 'createdAt'])
        && data.keys().size() >= 6 && data.keys().size() <= 31
        && data.id is string && data.id.size() <= 128 && data.id.size() > 0
        && (!data.keys().hasAny(['userName']) || (data.userName is string && data.userName.size() <= 100))
        && data.examType is string && data.examType.size() <= 100
        && (!data.keys().hasAny(['examRole']) || (data.examRole is string && data.examRole.size() <= 100))
        && (!data.keys().hasAny(['examPhase']) || (data.examPhase is string && data.examPhase.size() <= 100))
        && (!data.keys().hasAny(['examScope']) || (data.examScope is string && data.examScope.size() <= 100))
        && (!data.keys().hasAny(['platform']) || (data.platform is string && data.platform.size() <= 100))
        && (!data.keys().hasAny(['customPlatform']) || (data.customPlatform is string && data.customPlatform.size() <= 100))
        && data.mockName is string && data.mockName.size() <= 200
        && data.date is string && data.date.size() <= 50
        && (!data.keys().hasAny(['score']) || data.score is number || data.score == null)
        && (!data.keys().hasAny(['percentile']) || data.percentile is number || data.percentile == null)
        && (!data.keys().hasAny(['percentage']) || data.percentage is number || data.percentage == null)
        && (!data.keys().hasAny(['accuracy']) || data.accuracy is number || data.accuracy == null)
        && data.createdAt is timestamp
        && (!data.keys().hasAny(['quant']) || isValidNestedScore(data.quant))
        && (!data.keys().hasAny(['reasoning']) || isValidNestedScore(data.reasoning))
        && (!data.keys().hasAny(['english']) || isValidNestedScore(data.english))
        && (!data.keys().hasAny(['ga']) || isValidNestedScore(data.ga))
        && (!data.keys().hasAny(['streakAtTime']) || data.streakAtTime is number || data.streakAtTime == null)
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp || data.updatedAt == null)
        && (!data.keys().hasAny(['note']) || data.note is string || data.note == null)
        && (!data.keys().hasAny(['tags']) || data.tags is list || data.tags == null)
        && (!data.keys().hasAny(['isDeleted']) || data.isDeleted is bool);
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId'])
        && data.userId is string && data.userId == request.auth.uid
        && (!data.keys().hasAny(['displayName']) || data.displayName is string)
        && (!data.keys().hasAny(['photoURL']) || data.photoURL is string)
        && (!data.keys().hasAny(['targetedExam']) || data.targetedExam is string)
        && (!data.keys().hasAny(['avgPercentile']) || data.avgPercentile is number)
        && (!data.keys().hasAny(['avgAccuracy']) || data.avgAccuracy is number)
        && (!data.keys().hasAny(['avgQuantPercentile']) || data.avgQuantPercentile is number)
        && (!data.keys().hasAny(['avgReasoningPercentile']) || data.avgReasoningPercentile is number)
        && (!data.keys().hasAny(['avgEnglishPercentile']) || data.avgEnglishPercentile is number)
        && (!data.keys().hasAny(['avgGaPercentile']) || data.avgGaPercentile is number)
        && (!data.keys().hasAny(['totalTests']) || data.totalTests is number)
        && (!data.keys().hasAny(['streak']) || data.streak is number)
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp)
        && (!data.keys().hasAny(['isBanned']) || data.isBanned is bool)
        && (!data.keys().hasAny(['isMuted']) || data.isMuted is bool)
        && (!data.keys().hasAny(['lastMockDate']) || data.lastMockDate is string)
        && (!data.keys().hasAny(['role']) || data.role is string);
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['userId', 'userName', 'userPhoto', 'text', 'createdAt'])
        && data.keys().size() == 5
        && data.userId is string && data.userId == request.auth.uid
        && data.userName is string && data.userName.size() <= 100
        && data.userPhoto is string && data.userPhoto.size() <= 500
        && data.text is string && data.text.size() > 0 && data.text.size() <= 2000
        && data.createdAt is number;
    }

    match /system/{docId} {
      allow read: if isSignedIn();
      allow create: if isAdminUser() || (isSignedIn() && incoming().type == 'liveMock' && incoming().createdBy == request.auth.uid);
      allow update: if isAdminUser() || (isSignedIn() && existing().type == 'liveMock' && existing().createdBy == request.auth.uid && incoming().type == 'liveMock');
      allow delete: if isAdminUser() || (isSignedIn() && existing().type == 'liveMock' && existing().createdBy == request.auth.uid);
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /community_chat/{messageId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidChatMessage(incoming());
      allow update: if isAdminUser() || (isSignedIn() && existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'isEdited', 'updatedAt']) && incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 2000);
      allow delete: if isAdminUser() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUserProfile(incoming());
      allow update: if (isSignedIn() && request.auth.uid == userId && isValidUserProfile(incoming()) && (
        !incoming().diff(existing()).affectedKeys().hasAny(['isBanned', 'isMuted', 'role'])
      )) || isAdminUser();
      allow delete: if false; // Users shouldn't delete profile or let's say false for now
    }

    match /{path=**}/mocks/{mockId} {
      // Allow reading across all mocks to build the leaderboard
       allow read: if isSignedIn();
    }

    match /users/{userId}/mocks/{mockId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      
      allow create: if isSignedIn() 
        && request.auth.uid == incoming().userId
        && request.auth.uid == userId
        && isValidId(mockId)
        && isValidMockScore(incoming())
        && incoming().createdAt == request.time;
        
      allow update: if (isSignedIn() 
        && request.auth.uid == userId
        && isValidId(mockId)
        && isValidMockScore(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['id', 'userId', 'userName', 'examType', 'examRole', 'examPhase', 'examScope', 'platform', 'customPlatform', 'mockName', 'date', 'score', 'percentile', 'percentage', 'accuracy', 'quant', 'reasoning', 'english', 'ga', 'createdAt', 'updatedAt', 'streakAtTime', 'note', 'tags', 'isDeleted'])
        && incoming().id == existing().id
        && incoming().userId == existing().userId) || isAdminUser();
        
      allow delete: if (isSignedIn() && request.auth.uid == userId && isValidId(mockId)) || isAdminUser();
    }
  }
}
