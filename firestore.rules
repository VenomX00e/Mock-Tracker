rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'mrityunjoyk29@gmail.com';
    }

    function isAnyAdmin() {
      return isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'owner']
      );
    }

    function isValidNestedScore(nested) {
      return nested is map 
        && (!nested.keys().hasAny(['score']) || nested.score is number || nested.score == null)
        && (!nested.keys().hasAny(['percentile']) || nested.percentile is number || nested.percentile == null)
        && (!nested.keys().hasAny(['accuracy']) || nested.accuracy is number || nested.accuracy == null);
    }

    function isValidMockScore(data) {
      return data.keys().hasAll(['id', 'userId', 'examType', 'mockName', 'date', 'createdAt'])
        && data.keys().size() >= 6 && data.keys().size() <= 40
        && data.id is string && data.id.size() <= 128 && data.id.size() > 0
        && (!data.keys().hasAny(['userName']) || (data.userName is string && data.userName.size() <= 100))
        && data.examType is string && data.examType.size() <= 100
        && (!data.keys().hasAny(['examRole']) || (data.examRole is string && data.examRole.size() <= 100))
        && (!data.keys().hasAny(['examPhase']) || (data.examPhase is string && data.examPhase.size() <= 100))
        && (!data.keys().hasAny(['examScope']) || (data.examScope is string && data.examScope.size() <= 100))
        && (!data.keys().hasAny(['platform']) || (data.platform is string && data.platform.size() <= 100))
        && (!data.keys().hasAny(['customPlatform']) || (data.customPlatform is string && data.customPlatform.size() <= 100))
        && data.mockName is string && data.mockName.size() <= 200
        && data.date is string && data.date.size() <= 50
        && (!data.keys().hasAny(['score']) || data.score is number || data.score == null)
        && (!data.keys().hasAny(['percentile']) || data.percentile is number || data.percentile == null)
        && (!data.keys().hasAny(['percentage']) || data.percentage is number || data.percentage == null)
        && (!data.keys().hasAny(['accuracy']) || data.accuracy is number || data.accuracy == null)
        && data.createdAt is timestamp
        && (!data.keys().hasAny(['quant']) || isValidNestedScore(data.quant))
        && (!data.keys().hasAny(['reasoning']) || isValidNestedScore(data.reasoning))
        && (!data.keys().hasAny(['english']) || isValidNestedScore(data.english))
        && (!data.keys().hasAny(['ga']) || isValidNestedScore(data.ga))
        && (!data.keys().hasAny(['streakAtTime']) || data.streakAtTime is number || data.streakAtTime == null)
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp || data.updatedAt == null)
        && (!data.keys().hasAny(['note']) || data.note is string || data.note == null)
        && (!data.keys().hasAny(['tags']) || data.tags is list || data.tags == null)
        && (!data.keys().hasAny(['difficulty']) || data.difficulty is string || data.difficulty == null)
        && (!data.keys().hasAny(['nervousness']) || data.nervousness is string || data.nervousness == null)
        && (!data.keys().hasAny(['focus']) || data.focus is string || data.focus == null)
        && (!data.keys().hasAny(['energy']) || data.energy is string || data.energy == null)
        && (!data.keys().hasAny(['timeState']) || data.timeState is string || data.timeState == null)
        && (!data.keys().hasAny(['tasks']) || data.tasks is list || data.tasks == null)
        && (!data.keys().hasAny(['isDeleted']) || data.isDeleted is bool)
        && (!data.keys().hasAny(['categoryId']) || data.categoryId is string)
        && (!data.keys().hasAny(['dynamicSubjects']) || data.dynamicSubjects is map);
    }

    function isValidCustomVocabFolder(data) {
      return data.keys().hasAll(['id', 'name', 'vocabIds'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.vocabIds is list && data.vocabIds.size() <= 5000
        && (!data.keys().hasAny(['createdAt']) || data.createdAt is timestamp || data.createdAt is string || data.createdAt is number)
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp || data.updatedAt is string || data.updatedAt is number);
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId'])
        && data.userId is string && data.userId == request.auth.uid
        && (!data.keys().hasAny(['displayName']) || data.displayName is string || data.displayName == null)
        && (!data.keys().hasAny(['photoURL']) || data.photoURL is string || data.photoURL == null)
        && (!data.keys().hasAny(['email']) || data.email is string || data.email == null)
        && (!data.keys().hasAny(['targetedExam']) || data.targetedExam is string || data.targetedExam == null)
        && (!data.keys().hasAny(['avgPercentile']) || data.avgPercentile is number || data.avgPercentile == null)
        && (!data.keys().hasAny(['avgAccuracy']) || data.avgAccuracy is number || data.avgAccuracy == null)
        && (!data.keys().hasAny(['avgQuantPercentile']) || data.avgQuantPercentile is number || data.avgQuantPercentile == null)
        && (!data.keys().hasAny(['avgReasoningPercentile']) || data.avgReasoningPercentile is number || data.avgReasoningPercentile == null)
        && (!data.keys().hasAny(['avgEnglishPercentile']) || data.avgEnglishPercentile is number || data.avgEnglishPercentile == null)
        && (!data.keys().hasAny(['avgGaPercentile']) || data.avgGaPercentile is number || data.avgGaPercentile == null)
        && (!data.keys().hasAny(['totalTests']) || data.totalTests is number || data.totalTests == null)
        && (!data.keys().hasAny(['streak']) || data.streak is number || data.streak == null)
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp || data.updatedAt is number || data.updatedAt is string || data.updatedAt == null)
        && (!data.keys().hasAny(['isBanned']) || data.isBanned is bool || data.isBanned == null)
        && (!data.keys().hasAny(['isMuted']) || data.isMuted is bool || data.isMuted == null)
        && (!data.keys().hasAny(['lastMockDate']) || data.lastMockDate is string || data.lastMockDate == null)
        && (!data.keys().hasAny(['role']) || data.role is string || data.role == null)
        && (!data.keys().hasAny(['categoryId']) || data.categoryId is string || data.categoryId == null)
        && (!data.keys().hasAny(['dynamicSubjects']) || data.dynamicSubjects is map || data.dynamicSubjects == null)
        && (!data.keys().hasAny(['streakActive']) || data.streakActive is bool || data.streakActive == null)
        && (!data.keys().hasAny(['dynamicAverages']) || data.dynamicAverages is map || data.dynamicAverages == null)
        && (!data.keys().hasAny(['stats30D']) || data.stats30D is map || data.stats30D == null)
        && (!data.keys().hasAny(['stats7D']) || data.stats7D is map || data.stats7D == null)
        && (!data.keys().hasAny(['categoryStats']) || data.categoryStats is map || data.categoryStats == null)
        && (!data.keys().hasAny(['badges']) || data.badges is map || data.badges is list || data.badges == null)
        && (!data.keys().hasAny(['bio']) || data.bio is string || data.bio == null)
        && (!data.keys().hasAny(['yptNames']) || data.yptNames is list || data.yptNames == null)
        && (!data.keys().hasAny(['defaultYptHandle']) || data.defaultYptHandle is string || data.defaultYptHandle == null)
        && (!data.keys().hasAny(['permissions']) || data.permissions is map || data.permissions == null)
        && (!data.keys().hasAny(['tasks']) || data.tasks is list || data.tasks == null)
        && (!data.keys().hasAny(['completedPracticeFiles']) || data.completedPracticeFiles is list || data.completedPracticeFiles == null)
        && (!data.keys().hasAny(['favoriteVocabIds']) || (data.favoriteVocabIds is list && data.favoriteVocabIds.size() <= 10000) || data.favoriteVocabIds == null)
        && (!data.keys().hasAny(['lastActiveAt']) || data.lastActiveAt is number || data.lastActiveAt is timestamp || data.lastActiveAt == null);
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['userId', 'userName', 'userPhoto', 'text', 'createdAt'])
        && data.keys().size() >= 5 && data.keys().size() <= 11
        && data.userId is string && data.userId == request.auth.uid
        && data.userName is string && data.userName.size() <= 100
        && data.userPhoto is string && data.userPhoto.size() <= 500
        && data.text is string && data.text.size() <= 2000
        && data.createdAt is number
        && (!data.keys().hasAny(['replyTo']) || (data.replyTo is map && data.replyTo.keys().hasAll(['id', 'text', 'userName'])))
        && (!data.keys().hasAny(['reactions']) || data.reactions is map)
        && (!data.keys().hasAny(['poll']) || data.poll is map)
        && (!data.keys().hasAny(['isPoll']) || data.isPoll is bool)
        && (!data.keys().hasAny(['isPinned']) || data.isPinned is bool)
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is number);
    }

    function isValidChallenge(data) {
      return data.keys().hasAll(['title', 'startDate', 'endDate'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 2000))
        && (!data.keys().hasAny(['challengeType']) || (data.challengeType is string && data.challengeType.size() <= 50))
        && (!data.keys().hasAny(['todoFrequency']) || (data.todoFrequency is string && data.todoFrequency.size() <= 50))
        && (!data.keys().hasAny(['visibility']) || (data.visibility is string && data.visibility.size() <= 50))
        && (!data.keys().hasAny(['startDate']) || (data.startDate is string && data.startDate.size() <= 50))
        && (!data.keys().hasAny(['endDate']) || (data.endDate is string && data.endDate.size() <= 50))
        && (!data.keys().hasAny(['status']) || (data.status is string && data.status.size() <= 50))
        && (!data.keys().hasAny(['approvalStatus']) || (data.approvalStatus is string && data.approvalStatus.size() <= 50))
        && (!data.keys().hasAny(['categoryId']) || (data.categoryId is string && data.categoryId.size() <= 128))
        && (!data.keys().hasAny(['creatorId']) || (data.creatorId is string && data.creatorId.size() <= 128))
        && (!data.keys().hasAny(['id']) || (data.id is string && data.id.size() <= 128))
        && (!data.keys().hasAny(['durationDays']) || data.durationDays is number)
        && (!data.keys().hasAny(['createdAt']) || data.createdAt is string || data.createdAt is timestamp)
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is string || data.updatedAt is timestamp)
        && (!data.keys().hasAny(['deletedByAdmin']) || data.deletedByAdmin is bool)
        && (!data.keys().hasAny(['deletedByCreator']) || data.deletedByCreator is bool)
        && (!data.keys().hasAny(['permanentlyDeletedByAdmin']) || data.permanentlyDeletedByAdmin is bool)
        && (!data.keys().hasAny(['permanentlyDeletedByCreator']) || data.permanentlyDeletedByCreator is bool)
        && (!data.keys().hasAny(['tasks']) || (data.tasks is list && data.tasks.size() <= 100))
        && (!data.keys().hasAny(['badge']) || data.badge is map);
    }

    function isValidChallengeParticipant(data) {
      return (!data.keys().hasAny(['displayName']) || (data.displayName is string && data.displayName.size() <= 100))
        && (!data.keys().hasAny(['photoURL']) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!data.keys().hasAny(['streak']) || data.streak is number)
        && (!data.keys().hasAny(['totalMocks']) || data.totalMocks is number)
        && (!data.keys().hasAny(['dailyMocks']) || data.dailyMocks is number)
        && (!data.keys().hasAny(['lastCheckInDate']) || (data.lastCheckInDate is string && data.lastCheckInDate.size() <= 50))
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is string || data.updatedAt is timestamp)
        && (!data.keys().hasAny(['checkInDates']) || (data.checkInDates is list && data.checkInDates.size() <= 500))
        && (!data.keys().hasAny(['checkInTimes']) || data.checkInTimes is map)
        && (!data.keys().hasAny(['completedTasks']) || data.completedTasks is map)
        && (!data.keys().hasAny(['activities']) || (data.activities is list && data.activities.size() <= 500))
        && (!data.keys().hasAny(['awardedBadge']) || data.awardedBadge is bool);
    }

    function isValidSearchApiLog(data) {
      return data.keys().hasAll(['apiName', 'query', 'status', 'createdAt'])
        && data.keys().size() >= 4 && data.keys().size() <= 5
        && data.apiName is string && data.apiName.size() <= 100
        && data.query is string && data.query.size() <= 1000
        && data.status is string && data.status in ['success', 'error']
        && data.createdAt is timestamp
        && (!data.keys().hasAny(['errorMessage']) || (data.errorMessage is string && data.errorMessage.size() <= 2000));
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /system/{docId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAnyAdmin() || (isSignedIn() && docId in ['settings', 'ypt_hub_settings']) || (isSignedIn() && incoming().type == 'liveMock' && incoming().createdBy == request.auth.uid);
      allow update: if isAnyAdmin() 
        || (isSignedIn() && docId in ['settings', 'ypt_hub_settings'])
        || (isSignedIn() && existing().type == 'liveMock' && existing().createdBy == request.auth.uid && incoming().type == 'liveMock' && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'link', 'createdAt', 'createdBy', 'type', 'updatedAt', 'color', 'icon', 'categoryId']) && (!incoming().keys().hasAny(['createdBy']) || incoming().createdBy == existing().createdBy) && (!incoming().keys().hasAny(['createdAt']) || incoming().createdAt == existing().createdAt)) 
        || (isSignedIn() && existing().type == 'notice' && existing().editableBy == 'users' && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'updatedAt', 'lastEditedBy', 'lastEditedByEmail']));
      allow delete: if isAnyAdmin() || (isSignedIn() && existing().type == 'liveMock' && existing().createdBy == request.auth.uid);
    }

    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow create: if isAnyAdmin() || (isSignedIn() && incoming().keys().hasAll(['creatorId']) && incoming().creatorId == request.auth.uid && isValidChallenge(incoming()));
      allow update: if isAnyAdmin() || (
        isSignedIn() 
        && existing().keys().hasAll(['creatorId']) 
        && existing().creatorId == request.auth.uid 
        && (!incoming().keys().hasAny(['creatorId']) || incoming().creatorId == existing().creatorId)
        && (!incoming().keys().hasAny(['createdAt']) || incoming().createdAt == existing().createdAt)
        && isValidChallenge(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'challengeType', 'todoFrequency', 'visibility', 'tasks', 'startDate', 'endDate', 'durationDays', 'status', 'updatedAt', 'categoryId', 'deletedByCreator', 'permanentlyDeletedByCreator', 'approvalStatus', 'id', 'createdAt', 'badge'])
        && (!(existing().visibility == 'personal' && incoming().visibility == 'global') || incoming().approvalStatus == 'pending')
        && (!(existing().visibility == 'global' && existing().approvalStatus == 'pending' && incoming().approvalStatus == 'approved'))
      );
      allow delete: if isAnyAdmin() || (isSignedIn() && existing().keys().hasAll(['creatorId']) && existing().creatorId == request.auth.uid);
      
      match /participants/{userId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == userId && isValidChallengeParticipant(incoming());
        allow update: if isAnyAdmin() || (
          isSignedIn() 
          && request.auth.uid == userId 
          && incoming().diff(existing()).affectedKeys().hasOnly(['streak', 'lastCheckInDate', 'checkInDates', 'checkInTimes', 'updatedAt', 'displayName', 'photoURL', 'completedTasks', 'activities', 'totalMocks', 'dailyMocks', 'awardedBadge'])
          && isValidChallengeParticipant(incoming())
        );
        allow delete: if isAnyAdmin() || (isSignedIn() && request.auth.uid == userId);
      }
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /community_chat/{messageId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidChatMessage(incoming());
      allow update: if isAnyAdmin() 
        || (isSignedIn() && existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'isEdited', 'updatedAt']) && incoming().text is string && incoming().text.size() <= 2000 && incoming().updatedAt is number)
        || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['reactions']) && incoming().reactions is map)
        || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['poll']) && incoming().poll is map)
        || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['reactions', 'poll']) && incoming().reactions is map && incoming().poll is map);
      allow delete: if isAnyAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUserProfile(incoming());
      allow update: if isSuperAdmin() 
        || (isSignedIn() && request.auth.uid == userId && isValidUserProfile(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly([
          'userId', 'email', 'displayName', 'photoURL', 'targetedExam', 'avgPercentile', 'avgAccuracy', 'avgQuantPercentile', 
          'avgReasoningPercentile', 'avgEnglishPercentile', 'avgGaPercentile', 'totalTests', 'streak', 
          'updatedAt', 'lastMockDate', 'categoryId', 'dynamicSubjects', 'streakActive', 'dynamicAverages', 'stats30D', 'stats7D', 'categoryStats', 'badges', 'bio', 'yptNames', 'defaultYptHandle', 'tasks', 'lastActiveAt',
          'completedPracticeFiles', 'favoriteVocabIds'
        ]) && (!incoming().keys().hasAny(['createdAt']) || incoming().createdAt == existing().createdAt)) 
        || (isAnyAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
          'userId', 'email', 'isBanned', 'isMuted', 'adminCategories', 'displayName', 'photoURL', 'targetedExam', 'avgPercentile', 
          'avgAccuracy', 'avgQuantPercentile', 'avgReasoningPercentile', 'avgEnglishPercentile', 'avgGaPercentile', 
          'totalTests', 'streak', 'updatedAt', 'lastMockDate', 'categoryId', 'dynamicSubjects', 'streakActive', 'dynamicAverages', 'stats30D', 'stats7D', 'categoryStats', 'badges', 'bio', 'yptNames', 'defaultYptHandle', 'tasks', 'lastActiveAt',
          'completedPracticeFiles', 'favoriteVocabIds'
        ]));
      allow delete: if false; // Users shouldn't delete profile or let's say false for now

      match /customVocabFolders/{folderId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() 
          && request.auth.uid == userId 
          && isValidId(folderId) 
          && isValidCustomVocabFolder(incoming())
          && incoming().id == folderId;
        allow update: if isSignedIn() 
          && request.auth.uid == userId 
          && isValidId(folderId) 
          && isValidCustomVocabFolder(incoming())
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'vocabIds', 'updatedAt'])
          && incoming().id == existing().id;
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(folderId);
      }
    }

    match /{path=**}/mocks/{mockId} {
      // Allow reading across all mocks to build the leaderboard
       allow read: if isSignedIn();
    }

    match /users/{userId}/mocks/{mockId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      
      allow create: if isSignedIn() 
        && request.auth.uid == incoming().userId
        && request.auth.uid == userId
        && isValidId(mockId)
        && isValidMockScore(incoming())
        && incoming().createdAt == request.time;
        
      allow update: if (isSignedIn() 
        && request.auth.uid == userId
        && isValidId(mockId)
        && isValidMockScore(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['id', 'userId', 'userName', 'examType', 'examRole', 'examPhase', 'examScope', 'platform', 'customPlatform', 'mockName', 'date', 'score', 'percentile', 'percentage', 'accuracy', 'quant', 'reasoning', 'english', 'ga', 'createdAt', 'updatedAt', 'streakAtTime', 'note', 'tags', 'difficulty', 'nervousness', 'focus', 'energy', 'timeState', 'tasks', 'isDeleted', 'categoryId', 'dynamicSubjects'])
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && (!incoming().keys().hasAny(['createdAt']) || incoming().createdAt == existing().createdAt)) || isAnyAdmin();
        
      allow delete: if (isSignedIn() && request.auth.uid == userId && isValidId(mockId)) || isAnyAdmin();
    }
    match /editorial_canvases/{canvasId} {
      allow read: if isSignedIn();
      allow write: if isAnyAdmin();
    }

    match /practice_folders/{folderId} {
      allow read: if true;
      allow create, update: if isAnyAdmin();
      allow delete: if isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
      );
    }

    match /practice_files/{fileId} {
      allow read: if true;
      allow create, update: if isAnyAdmin();
      allow delete: if isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
      );
    }

    match /learning_courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAnyAdmin();
    }

    match /learning_modules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if isAnyAdmin();
    }

    match /learning_progress/{progressId} {
      allow read: if isSignedIn() && (existing() == null || existing().userId == request.auth.uid);
      allow create, update: if isSignedIn() && incoming().userId == request.auth.uid && progressId == request.auth.uid + "_" + incoming().courseId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /app_updates/{updateId} {
      // Everyone can view existing update logs
      allow read: if true;
      
      // ONLY the authentic owner account is allowed to publish or rewrite logs
      allow write: if request.auth != null && 
                   request.auth.token.email == 'mrityunjoyk29@gmail.com' &&
                   request.auth.token.email_verified == true;
    }
    
    match /cloudinary_webhook_logs/{logId} {
      allow read: if request.auth != null && request.auth.token.email == "mrityunjoyk29@gmail.com";
      allow write: if request.auth != null && request.auth.token.email == "mrityunjoyk29@gmail.com";
    }

    match /search_api_logs/{logId} {
      allow read: if isAnyAdmin();
      allow create: if isAnyAdmin() && isValidSearchApiLog(incoming()) && incoming().createdAt == request.time;
      allow update: if isAnyAdmin() && isValidSearchApiLog(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'errorMessage', 'apiName', 'query']) && (!incoming().keys().hasAny(['createdAt']) || incoming().createdAt == existing().createdAt);
      allow delete: if isAnyAdmin();
    }

    match /metadata/release {
      allow read: if true;
      allow write: if request.auth != null && 
                   request.auth.token.email == 'mrityunjoyk29@gmail.com' &&
                   request.auth.token.email_verified == true;
    }

    match /system_config/{docId} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }

    match /platform_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAnyAdmin();
    }

    match /yptChallenges/{challengeId} {
      allow read, create, update, delete: if isSignedIn();

      match /submissions/{submissionId} {
        allow read, create, update, delete: if isSignedIn();
      }

      match /daily_snapshots/{snapshotId} {
        allow read, create, update, delete: if isSignedIn();
      }

      match /dailySnapshots/{snapshotId} {
        allow read, create, update, delete: if isSignedIn();
      }
    }
  }
}
