{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with display name, image, and aggregated stats",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "targetedExam": { "type": "string" },
        "avgPercentile": { "type": "number" },
        "avgQuantPercentile": { "type": "number" },
        "avgReasoningPercentile": { "type": "number" },
        "avgEnglishPercentile": { "type": "number" },
        "totalTests": { "type": "number" },
        "streak": { "type": "number" },
        "updatedAt": { "type": "string" },
        "isBanned": { "type": "boolean" },
        "isMuted": { "type": "boolean" },
        "lastMockDate": { "type": "string" },
        "role": { "type": "string" },
        "yptNames": {
          "type": "array",
          "items": { "type": "string" }
        },
        "favoriteVocabIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["userId"]
    },
    "MockScore": {
      "title": "MockScore",
      "description": "Records of mock exams taken by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "examType": { "type": "string" },
        "examRole": { "type": "string" },
        "examPhase": { "type": "string" },
        "examScope": { "type": "string" },
        "mockName": { "type": "string" },
        "date": { "type": "string" },
        "score": { "type": "number" },
        "percentile": { "type": "number" },
        "percentage": { "type": "number" },
        "quant": {
          "type": "object",
          "properties": {
            "score": { "type": "number" },
            "percentile": { "type": "number" }
          }
        },
        "reasoning": {
          "type": "object",
          "properties": {
            "score": { "type": "number" },
            "percentile": { "type": "number" }
          }
        },
        "english": {
          "type": "object",
          "properties": {
            "score": { "type": "number" },
            "percentile": { "type": "number" }
          }
        },
        "ga": {
          "type": "object",
          "properties": {
            "score": { "type": "number" },
            "percentile": { "type": "number" }
          }
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "note": { "type": "string" },
        "tags": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "difficulty": { "type": "string" },
        "nervousness": { "type": "string" },
        "focus": { "type": "string" },
        "energy": { "type": "string" },
        "timeState": { "type": "string" },
        "tasks": {
          "type": "array",
          "items": { 
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "completed": { "type": "boolean" }
            }
          }
        }
      },
      "required": ["id", "userId", "examType", "mockName", "date", "score", "percentile", "percentage", "quant", "reasoning", "english", "ga"]
    },
    "CommunityChat": {
      "title": "CommunityChat",
      "description": "Messages sent by users in the community hub",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "userName", "userPhoto", "text", "createdAt"]
    },
    "app_update": {
      "title": "App Update",
      "description": "Collection storing application changelog features and version info.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "releaseDate": { "type": "string" },
        "title": { "type": "string" },
        "badgeText": { "type": "string" },
        "featuresGroupA": { "type": "object" },
        "featuresGroupB": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["version", "title", "createdAt"]
    },
    "ReleaseMetadata": {
      "title": "ReleaseMetadata",
      "description": "Pointer to the latest app release version",
      "type": "object",
      "properties": {
        "latestVersion": { "type": "string" }
      },
      "required": ["latestVersion"]
    },
    "SearchApiLog": {
      "title": "SearchApiLog",
      "description": "Logs of external search API calls",
      "type": "object",
      "properties": {
        "apiName": { "type": "string" },
        "query": { "type": "string" },
        "status": { "type": "string", "enum": ["success", "error"] },
        "errorMessage": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["apiName", "query", "status", "createdAt"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Global settings document",
      "type": "object",
      "properties": {
        "searchLogAutoDeleteDays": { "type": "number" },
        "telegramLink": { "type": "string" },
        "telegramText": { "type": "string" },
        "enableAiTutor": { "type": "boolean" },
        "enableVocabulary": { "type": "boolean" },
        "enableSpeedMath": { "type": "boolean" },
        "enablePracticeLibrary": { "type": "boolean" }
      }
    },
    "YptChallenge": {
      "title": "YptChallenge",
      "description": "YPT group challenge with study rules and team rosters",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "leaderUid": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "completed", "draft"] },
        "rules": { "type": "object" },
        "teams": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "leaderUid", "startDate", "endDate", "status"]
    },
    "YptSubmissionLog": {
      "title": "YptSubmissionLog",
      "description": "Verified study logs and OCR screenshot extraction entries for YPT challenge",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "challengeId": { "type": "string" },
        "uploaderUid": { "type": "string" },
        "imageUrl": { "type": "string" },
        "extractedMembers": { "type": "array" },
        "totalPointsAwarded": { "type": "number" },
        "timestamp": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "verified", "rejected"] }
      },
      "required": ["id", "challengeId", "uploaderUid", "status"]
    },
    "PlatformLearningSettings": {
      "title": "PlatformLearningSettings",
      "description": "Global learning section and vocabulary extraction default configuration",
      "type": "object",
      "properties": {
        "vocabExtraction": {
          "type": "object",
          "properties": {
            "defaultCustomInstructions": { "type": "string" },
            "defaultTargetLevel": { "type": "string" },
            "defaultWordCount": { "type": "number" },
            "defaultNativeLanguage": { "type": "string" }
          }
        },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      }
    },
    "CustomVocabFolder": {
      "title": "CustomVocabFolder",
      "description": "User-created custom folder for organizing favorited vocabulary words",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "vocabIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "vocabIds"]
    },
    "YptDailyDaySnapshot": {
      "title": "YptDailyDaySnapshot",
      "description": "Daily finalized score and study hours snapshot for YPT challenge",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "challengeId": { "type": "string" },
        "dateYmd": { "type": "string" },
        "isLocked": { "type": "boolean" },
        "lockedAt": { "type": "string" },
        "lockedBy": { "type": "string", "enum": ["cron_system", "admin_manual"] },
        "totalChallengeHours": { "type": "number" },
        "totalChallengePoints": { "type": "number" },
        "activeMemberCount": { "type": "number" },
        "memberSnapshots": { "type": "object" },
        "teamStandings": { "type": "array" }
      },
      "required": ["id", "challengeId", "dateYmd", "isLocked", "totalChallengeHours", "totalChallengePoints", "activeMemberCount", "memberSnapshots", "teamStandings"]
    }
  },
  "firestore": {
    "yptChallenges/{challengeId}": {
      "schema": { "$ref": "#/entities/YptChallenge" },
      "description": "YPT study challenges and teams"
    },
    "yptChallenges/{challengeId}/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/YptSubmissionLog" },
      "description": "OCR submission logs for a YPT challenge"
    },
    "yptChallenges/{challengeId}/dailySnapshots/{snapshotId}": {
      "schema": { "$ref": "#/entities/YptDailyDaySnapshot" },
      "description": "Permanent date-keyed daily snapshots for a YPT challenge"
    },
    "yptChallenges/{challengeId}/daily_snapshots/{snapshotId}": {
      "schema": { "$ref": "#/entities/YptDailyDaySnapshot" },
      "description": "Finalized daily snapshots for a YPT challenge"
    },
    "users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile containing metadata and aggregates"
    },
    "users/{userId}/customVocabFolders/{folderId}": {
      "schema": { "$ref": "#/entities/CustomVocabFolder" },
      "description": "Custom vocabulary folders created by the user"
    },
    "users/{userId}/mocks/{mockId}": {
      "schema": { "$ref": "#/entities/MockScore" },
      "description": "Mock scores specific to a user."
    },
    "community_chat/{messageId}": {
      "schema": { "$ref": "#/entities/CommunityChat" },
      "description": "Community chat messages"
    },
    "app_updates/{updateId}": {
      "schema": { "$ref": "#/entities/app_update" },
      "description": "Dynamic changelog store."
    },
    "metadata/release": {
      "schema": { "$ref": "#/entities/ReleaseMetadata" },
      "description": "Pointer to the latest app release version"
    },
    "search_api_logs/{logId}": {
      "schema": { "$ref": "#/entities/SearchApiLog" },
      "description": "Logs for search API usage"
    },
    "system/settings": {
      "schema": { "$ref": "#/entities/SystemSettings" },
      "description": "Global settings for the application"
    },
    "platform_settings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformLearningSettings" },
      "description": "Platform settings for learning and vocabulary extraction"
    }
  }
}
